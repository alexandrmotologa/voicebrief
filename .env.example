# Server Configuration
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# Demo Mode (runs offline without Telegram or AI API credentials)
DEMO_MODE=true

# Storage Paths
DATABASE_PATH=./data/voicebrief.db
AUDIO_STORAGE_PATH=./data/audio

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_MINI_APP_URL=http://localhost:8080

# AI Provider Credentials
OPENAI_API_KEY=
GROQ_API_KEY=

# Engine Selection: "groq", "openai", or "mock"
AI_TRANSCRIBER=groq
AI_SUMMARIZER=openai
